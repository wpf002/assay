{
  "name": "assay",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "assay": "pnpm --filter @assay/cli exec tsx src/index.ts",
    "db:migrate": "pnpm --filter @assay/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @assay/api exec prisma generate",
    "db:studio": "pnpm --filter @assay/api exec prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "prettier": "^3.3.0"
  }
}
