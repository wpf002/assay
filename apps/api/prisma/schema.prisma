generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model System {
  id          String       @id @default(cuid())
  name        String
  kind        String // repo | service | host | vendor_product
  owner       String?
  createdAt   DateTime     @default(now())
  occurrences Occurrence[]

  @@unique([name, kind])
}

model CryptoAsset {
  id                       String       @id // content hash: same triple, same row, forever
  primitive                String
  parameters               Json
  purpose                  String
  quantumVulnerable        Boolean
  classicalSecurityBits    Int?
  nistQuantumSecurityLevel Int?
  oid                      String?
  occurrences              Occurrence[]
  scans                    ScanAsset[]

  @@index([quantumVulnerable, purpose])
}

model Occurrence {
  // Content hash of (system, asset, control class). Stable across scans, which
  // is the only reason a diff is possible without maintaining a mapping table.
  id           String      @id
  asset        CryptoAsset @relation(fields: [assetId], references: [id])
  assetId      String
  system       System      @relation(fields: [systemId], references: [id])
  systemId     String
  /// The logical system the occurrence itself names, which is part of its
  /// content hash. `systemId` above is the System row the SCAN was filed
  /// under, and one scan may cover several logical systems; without this
  /// column the occurrence's own value is unrecoverable, and trace
  /// correlation and ticket export both key off it.
  systemKey    String
  controlClass String

  reachable       Boolean?
  reachVia        String? // OBSERVED | ENTRY_POINT | DEPLOYED_CONFIG | LIBRARY_SURFACE | NONE
  reachEntryPoint String?
  reachPath       Json? // CallFrame[], exported into CycloneDX evidence.callstack
  reachFactor     Json?

  confidence       Decimal @db.Decimal(6, 4)
  confidenceFactor Json // the full recursive Factor tree; there are no bare numbers
  assertionLevel   String // CONFIRMED | OBSERVED | SUSPECTED
  downgradeReason  String?

  // Ranking is stored per scan because it is pack-dependent. A re-rank under a
  // new pack must be a diff, not a rewrite (I4).
  urgencyTrack         String?
  moscaSlackYears      Decimal? @db.Decimal(6, 2)
  crqcSlackYears       Decimal? @db.Decimal(6, 2)
  regulatorySlackYears Decimal? @db.Decimal(6, 2)
  bindingConstraint    String?
  moscaFactor          Json?

  scan     Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId   String
  evidence Evidence[]

  @@unique([scanId, id])
  @@index([systemId, assertionLevel])
  @@index([urgencyTrack, moscaSlackYears])
  @@index([scanId, assetId])
}

model Evidence {
  id               String     @id @default(cuid())
  occurrence       Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  occurrenceId     String
  modality         String
  locator          String
  raw              String     @db.Text
  collectedAt      DateTime
  collectorVersion String

  // CycloneDX evidence.occurrences shape
  location String?
  line     Int?
  offset   Int?
  symbol   String?

  @@index([occurrenceId])
  @@index([modality])
}

model Scan {
  id                String       @id @default(cuid())
  systemName        String
  startedAt         DateTime     @default(now())
  finishedAt        DateTime?
  detectors         String[]
  policyPackId      String
  policyPackVersion String
  // Required for any scan that used a network detector. A probe without one
  // could not have run (I8); recording it makes that auditable after the fact.
  scopeGrantId      String?
  occurrences       Occurrence[]
  assets            ScanAsset[]

  @@index([systemName, startedAt])
}

/// The assets a scan declared, including any that produced no occurrence.
///
/// Reconstructing the asset set by walking occurrences loses exactly the
/// inventory entries that have no work item behind them, so a GET of a scan
/// would report fewer assets than the POST that wrote it.
model ScanAsset {
  scan    Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId  String
  asset   CryptoAsset @relation(fields: [assetId], references: [id])
  assetId String

  @@id([scanId, assetId])
  @@index([assetId])
}

/// Derived service graph from distributed traces.
///
/// PRIVACY: spans are ingested and DISCARDED. Only the edges survive - which
/// service called which, how often, and one representative operation name.
/// A span carries request attributes, user identifiers and sometimes payload
/// fragments, and a cryptographic inventory needs none of that to know that
/// the payments API calls the signing service. Persisting the raw spans would
/// turn this tool into a second copy of the most sensitive telemetry an
/// organization has, for no analytical gain.
model TraceBundle {
  id           String       @id
  source       String
  windowFrom   DateTime
  windowTo     DateTime
  ingestedAt   DateTime     @default(now())
  /// Count of spans seen at ingest. The spans themselves are not stored.
  spanCount    Int
  /// Services called from outside the traced estate: reachable by definition.
  rootServices String[]
  edges        TraceEdge[]

  @@index([ingestedAt])
}

model TraceEdge {
  id           String      @id @default(cuid())
  bundle       TraceBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId     String
  fromService  String
  toService    String
  observations Int
  operation    String

  @@unique([bundleId, fromService, toService])
  @@index([bundleId])
}

/// An API token.
///
/// The secret is never stored. What is stored is a SHA-256 of it, and the
/// secret is shown exactly once, at creation. An inventory of an
/// organization's weakest cryptography is one of the most sensitive documents
/// it owns; a token table that can be read back is a second copy of the key to
/// it.
model ApiToken {
  id        String    @id
  /// SHA-256 of the secret, hex. Unique so a lookup is a single indexed read
  /// rather than a scan-and-compare over every row.
  secretHash String   @unique
  name      String
  role      String // admin | operator | viewer
  /// Systems this token may read. Empty means every system — recorded
  /// explicitly rather than implied by absence.
  systems   String[]
  createdAt DateTime  @default(now())
  createdBy String
  lastUsedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?

  @@index([revokedAt])
}

/// Who read what.
///
/// The customer's own auditor asks this, and "we do not keep that" is not an
/// answer. Written for reads as well as writes: exfiltrating an inventory is a
/// read.
model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  tokenId    String?
  tokenName  String
  role       String
  method     String
  route      String
  /// The specific thing touched, where the route names one.
  resource   String?
  statusCode Int
  remoteAddr String

  @@index([at])
  @@index([tokenId, at])
}
