DATABASE_URL="postgresql://assay:assay@localhost:5432/assay?schema=public"
PORT=3001
NODE_ENV=development

# Scope grants must be signed. Generate with: pnpm assay scope keygen
ASSAY_SCOPE_PUBKEY=""

# Active network probing is OFF unless explicitly enabled AND scope-granted.
ASSAY_ALLOW_ACTIVE_PROBE=false

# Policy pack selects deadline/CRQC assumptions. See packages/policy/packs/
ASSAY_POLICY_PACK="eo-14412"
